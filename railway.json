{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacks": {
      "providers": ["python311"]
    }
  },
  "deploy": {
    "startCommand": "gunicorn --bind 0.0.0.0:${PORT:-8000} app:app",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 10
  }
}
